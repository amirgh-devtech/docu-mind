# ─────────────────────────────────────────────
# docu-mind — Environment Variables
# Copy to .env and fill in real values.
# ─────────────────────────────────────────────

# === App ===
APP_NAME=docu-mind
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# === Mode: eco | pro ===
# eco  → Gemini 3.5 Flash-Lite + OpenAI small embedding + free reranker
# pro  → Gemini 3.6 Flash + OpenAI large embedding (truncated) + Cohere Rerank
DOCU_MIND_MODE=eco

# === LLM Providers ===
# LiteLLM reads these. Only providers you use need to be set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# === Embedding ===
# eco → text-embedding-3-small (1536)
# pro → text-embedding-3-large (dimensions=1024)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_ECO=text-embedding-3-small
EMBEDDING_MODEL_PRO=text-embedding-3-large
EMBEDDING_DIM_ECO=1536
EMBEDDING_DIM_PRO=1024

# === Reranker ===
# eco → local ms-marco-MiniLM-L6-v2 (free)
# pro → cohere/rerank-v3.5
RERANKER_PROVIDER=local
RERANKER_MODEL_LOCAL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_MODEL_PRO=rerank-v3.5
COHERE_API_KEY=

# === Postgres (pgvector) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docu_mind
POSTGRES_USER=docu_mind
POSTGRES_PASSWORD=change_me_in_prod
DATABASE_URL=postgresql+asyncpg://docu_mind:change_me_in_prod@localhost:5432/docu_mind

# === Chunking ===
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CONTEXTUAL_CHUNKING=true

# === Retrieval ===
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
HYBRID_ALPHA=0.5
RRF_K=60

# === File uploads ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# === Security ===
SECRET_KEY=change_me_to_a_long_random_string
