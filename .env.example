# ─────────────────────────────────────────────
# docu-mind — Environment Variables
# Copy to .env and fill in real values.
# ─────────────────────────────────────────────

# === App ===
APP_NAME=docu-mind
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# === Mode ===
# eco  → Gemini 3.5 Flash-Lite + gemini-embedding + free reranker
# pro  → Gemini 3.6 Flash + gemini-embedding + Cohere Rerank
DOCU_MIND_MODE=eco           # eco | pro

# === LLM Providers ===
# LiteLLM reads these. Only providers you use need to be set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# === Embedding ===
# eco → gemini-embedding-001 (1536)
# pro → gemini-embedding-001 (1536)
EMBEDDING_PROVIDER=gemini                          # for openai: EMBEDDING_PROVIDER=openai
EMBEDDING_DIM_ECO=1536
EMBEDDING_DIM_PRO=1536
EMBEDDING_MODEL_ECO_GEMINI=gemini-embedding-001    # for openai: EMBEDDING_MODEL_ECO_OPENAI=text-embedding-3-small
EMBEDDING_MODEL_PRO_GEMINI=gemini-embedding-001    # for openai: EMBEDDING_MODEL_PRO_OPENAI=text-embedding-3-large

# === Reranker ===
# eco → local ms-marco-MiniLM-L6-v2 (free)
# pro → cohere/rerank-v3.5
RERANKER_PROVIDER=local
RERANKER_MODEL_LOCAL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_MODEL_PRO=rerank-v3.5
COHERE_API_KEY=

# === RAG ===
RAG_CONTEXT_TOKEN_BUDGET=6000
RAG_MAX_HISTORY_MESSAGES=10
RAG_INCLUDE_HISTORY=true

# === Postgres (pgvector) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docu_mind
POSTGRES_USER=docu_mind
POSTGRES_PASSWORD=change_me_in_prod
DATABASE_URL=postgresql+asyncpg://docu_mind:change_me_in_prod@localhost:5432/docu_mind

# === Chunking ===
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CONTEXTUAL_CHUNKING=true

# === Retrieval ===
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
HYBRID_ALPHA=0.5
RRF_K=60
RRF_DENSE_WEIGHT=0.7
RRF_KEYWORD_WEIGHT=0.3

# === Retrieval — keyword search ===
KEYWORD_TS_CONFIG=english      # simple | english | french | german | ...
KEYWORD_QUERY_MODE=websearch   # websearch | plain | phrase

# === File uploads ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
LLM_REQUEST_TIMEOUT=180

# === HuggingFace ===
# Read token (free) — improves download speed and rate limits
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=

# === Security ===
SECRET_KEY=change_me_to_a_long_random_string
